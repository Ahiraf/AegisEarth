# Live FastAPI workflow by default; snapshot explicitly selects saved IRSA records.
VITE_DATA_SOURCE=api
# Optional public API origin for separate hosting; empty uses same-origin /api.
VITE_API_BASE_URL=
# Dev proxy target; compose.foundation.yaml uses port 18000.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
