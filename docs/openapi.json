{
  "openapi": "3.1.0",
  "info": {
    "title": "Cosmic Motion AI API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/health/live": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Live",
        "operationId": "live_api_v1_health_live_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/v1/health/ready": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Ready",
        "operationId": "ready_api_v1_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/v1/observations/search": {
      "post": {
        "tags": [
          "observations"
        ],
        "summary": "Search Observations",
        "operationId": "search_observations_api_v1_observations_search_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ObservationSearch"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "503": {
            "description": "Discovery adapter not implemented"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/analyses": {
      "post": {
        "tags": [
          "analyses"
        ],
        "summary": "Submit Analysis",
        "operationId": "submit_analysis_api_v1_analyses_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnalysisRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "503": {
            "description": "Scientific pipeline not implemented"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/system/capabilities": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Capabilities",
        "operationId": "capabilities_api_v1_system_capabilities_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AnalysisRequest": {
        "properties": {
          "observation_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 6,
            "minItems": 2,
            "title": "Observation Ids"
          },
          "mode": {
            "type": "string",
            "enum": [
              "pair",
              "sequence"
            ],
            "title": "Mode",
            "default": "pair"
          },
          "center_ra_deg": {
            "type": "number",
            "exclusiveMaximum": 360.0,
            "minimum": 0.0,
            "title": "Center Ra Deg"
          },
          "center_dec_deg": {
            "type": "number",
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Center Dec Deg"
          },
          "cutout_size_arcmin": {
            "type": "number",
            "maximum": 5.0,
            "exclusiveMinimum": 0.0,
            "title": "Cutout Size Arcmin",
            "default": 2
          },
          "max_pixels": {
            "type": "integer",
            "maximum": 512.0,
            "minimum": 32.0,
            "title": "Max Pixels",
            "default": 256
          },
          "ranking_method": {
            "type": "string",
            "enum": [
              "classical",
              "cnn",
              "siamese"
            ],
            "title": "Ranking Method",
            "default": "classical"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "observation_ids",
          "center_ra_deg",
          "center_dec_deg"
        ],
        "title": "AnalysisRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ObservationSearch": {
        "properties": {
          "region": {
            "$ref": "#/components/schemas/SkyRegion"
          },
          "start_at": {
            "type": "string",
            "format": "date-time",
            "title": "Start At"
          },
          "end_at": {
            "type": "string",
            "format": "date-time",
            "title": "End At"
          },
          "collection": {
            "type": "string",
            "enum": [
              "spherex_qr3",
              "spherex_qr2"
            ],
            "title": "Collection",
            "default": "spherex_qr3"
          },
          "limit": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Limit",
            "default": 20
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "region",
          "start_at",
          "end_at"
        ],
        "title": "ObservationSearch"
      },
      "SkyRegion": {
        "properties": {
          "ra_deg": {
            "type": "number",
            "exclusiveMaximum": 360.0,
            "minimum": 0.0,
            "title": "Ra Deg"
          },
          "dec_deg": {
            "type": "number",
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Dec Deg"
          },
          "radius_deg": {
            "type": "number",
            "maximum": 0.1,
            "exclusiveMinimum": 0.0,
            "title": "Radius Deg"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "ra_deg",
          "dec_deg",
          "radius_deg"
        ],
        "title": "SkyRegion"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
