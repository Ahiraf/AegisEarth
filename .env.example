POSTGRES_USER=cosmic
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=cosmic_motion
DATABASE_URL=postgresql+psycopg://cosmic:local-development-only@localhost:5432/cosmic_motion
CORS_ORIGINS=["http://localhost:5173"]
ARTIFACT_ROOT=./var/artifacts
PROVIDER_USER_AGENT=AegisEarth/0.1 (+https://github.com/Ahiraf/AegisEarth/issues)
MAX_DOWNLOAD_BYTES=134217728
PROVIDER_TIMEOUT_SECONDS=30
DISCOVERY_TTL_SECONDS=900
OVERLAY_TTL_SECONDS=3600
REFRESH_COOLDOWN_SECONDS=300
# Optional protected metadata refresh; never put this token in React or coordinate URLs.
# REFRESH_ADMIN_TOKEN=replace-with-random-admin-secret
FRONTEND_VIEWER_URL=http://localhost:5173/viewer
# Explicit origins allowed to frame the backend reference embed. Production defaults to self only.
EMBED_ANCESTORS=["'self'"]
DATABASE_TRANSPORT=postgresql
# HTTPS PostgREST alternative: DATABASE_TRANSPORT=postgrest (native URL remains for migrations).
# GATEWAY_URL=https://your-database-gateway.example
# GATEWAY_TOKEN=server-side-service-jwt
# GATEWAY_CA_FILE=path/to/development-root-ca.pem

# Required for public POST /views; generate and keep a stable >=32-character server-only secret.
# PUBLIC_TOKEN_SECRET=replace-with-random-server-secret
PUBLIC_COOKIE_SECURE=false
VIEW_MAX_ACTIVE_PER_CLIENT=2
VIEW_MAX_HOURLY_PER_CLIENT=10
VIEW_MAX_HOURLY_PER_IP=30
VIEW_MAX_QUEUE=20
VIEW_MAX_WORKERS=2
VIEW_WALL_SECONDS=180
VIEW_CPU_SECONDS=60
VIEW_MEMORY_MB=512
VIEW_TOTAL_BYTES=268435456
OBJECT_STORE=local
METADATA_RANKER_ENABLED=false
INSTALL_METADATA_RANKER=false
METADATA_RANKER_WALL_SECONDS=600
METADATA_RANKER_MAX_CANDIDATES=24
# External S3-compatible store (API and worker share bucket/region/endpoint and AWS credentials):
# OBJECT_STORE=s3
# S3_BUCKET=your-private-bucket
# S3_ENDPOINT_URL=https://your-s3-endpoint.example
# S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=keep-server-side
# AWS_SECRET_ACCESS_KEY=keep-server-side
